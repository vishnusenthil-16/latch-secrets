{
  "manifest_version": 3,
  "name": "Latch password bridge",
  "version": "0.3.0",
  "minimum_chrome_version": "106",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "webNavigation",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "setup.html"
  }
}
